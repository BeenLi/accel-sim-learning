e=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="502" width="560" height="26" as="geometry"/></mxCell><mxCell id="n40" value="warp 1：threadIdx.y = 2, 3（tid 32–63）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="532" width="560" height="26" as="geometry"/></mxCell><mxCell id="n41" value="……" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="562" width="560" height="26" as="geometry"/></mxCell><mxCell id="n42" value="warp 7：threadIdx.y = 14, 15（tid 224–255）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="560" height="26" as="geometry"/></mxCell><mxCell id="n43" value="lane 0–15：16 个线程" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="502" width="280" height="40" as="geometry"/></mxCell><mxCell id="n44" value="lane 16–31：没有线程" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="900" y="502" width="280" height="40" as="geometry"/></mxCell><mxCell id="n45" value="trace 里这个 warp 的活跃掩码最多是 0000ffff：高 16 位永远是 0，这 16 条 lane 的计算能力被浪费" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="620" y="554" width="560" height="40" as="geometry"/></mxCell><mxCell id="n46" value="依据：tracer 的 warpid_tb = tid / 32（inject_funcs.cu:78-92）；模拟器把 CTA 补齐到 32 的整数倍再分 warp（gpu-sim.cc:2099-2102）" style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1160" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
